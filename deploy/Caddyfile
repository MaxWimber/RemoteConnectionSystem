# Phase 3: Caddy terminates HTTPS and proxies the client and the API to rcs-web on loopback (docs/SECURITY.md, D-021).
# rcs-web serves the /RemoteConnectionSystem prefix itself and sets CSP and the other page headers; Caddy adds HSTS.
{
	admin off
	# HTTP/3 would need UDP 8444, which is not forwarded.
	servers {
		protocols h1 h2
	}
	storage file_system C:/ProgramData/RCS/caddy
	log {
		output file C:/ProgramData/RCS/logs/caddy-system.log {
			roll_size 10MiB
			roll_keep 5
		}
	}
}

# External TCP 443 is closed for this connection, see D-013. The port belongs in the site address: with a global
# https_port Caddy assumes a forward from 443 and leaves the port out of the HTTP redirect.
# Port 80 stays open for that redirect and for certificate renewal.
https://maxwimber.ru:8444 {
	log {
		output file C:/ProgramData/RCS/logs/caddy.log {
			roll_size 10MiB
			roll_keep 5
		}
	}

	# Deferred, so these replace what rcs-web sent instead of doubling it. includeSubDomains waits for a subdomain check.
	header {
		defer
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		X-Frame-Options DENY
		-Server
	}

	redir /RemoteConnectionSystem /RemoteConnectionSystem/ 308

	# Caddy drops X-Forwarded-For from the browser and sends the real address; rcs-web trusts it only from loopback.
	handle /RemoteConnectionSystem/* {
		reverse_proxy 127.0.0.1:8080
	}

	handle {
		respond "Not Found" 404
	}
}
